// R.E.P.O. Field Guide dev container (VS Code "Dev Containers" + rootless Podman).
// One-time VS Code setting: "dev.containers.dockerPath": "podman"
// Then: Command Palette → "Dev Containers: Reopen in Container".
{
  "name": "R.E.P.O. Field Guide",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "containerUser": "vscode",

  // Rootless Podman: map your host user to the container's vscode user (both uid 1000),
  // so files created in the repo stay owned by you.
  "runArgs": ["--userns=keep-id", "--security-opt=label=disable"],
  "updateRemoteUserUID": false,

  // Same path as on the host, so tools that key data by folder path (like Claude Code
  // sessions) see the same project inside and outside the container.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",

  "mounts": [
    // Claude Code login, settings, memory and session history.
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind",
    // Game assemblies, read-only: used to check game data and to build the mod.
    // Change the source path here if your Steam library lives elsewhere.
    "source=${localEnv:HOME}/.local/share/Steam/steamapps/common/REPO/REPO_Data/Managed,target=/game/Managed,type=bind,readonly",
    // r2modman profiles, so `npm run mod:install` can drop a fresh build into a profile.
    "source=${localEnv:HOME}/.config/r2modmanPlus-local/REPO/profiles,target=/r2modman/profiles,type=bind"
  ],

  "containerEnv": {
    "REPO_GAME_MANAGED": "/game/Managed",
    "R2MODMAN_PROFILES": "/r2modman/profiles"
  },

  "forwardPorts": [5173, 47380],
  "portsAttributes": {
    "5173": { "label": "Website (Vite)" },
    "47380": { "label": "Mock game server", "onAutoForward": "silent" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csharp"]
    }
  }
}
