  "tips": [
    {
      "id": "pool",
      "title": "The upgrade pool trick",
      "text": "The shop draws from a limited upgrade pool. Upgrades that exist in your run (on shelves or bought and stored but not used yet) take up slots. Hoarding duplicates you don't use can push other upgrades onto the shelf. Community tip: when several of the cheap Stamina upgrades show up (for example 3), buying them all clears them out of the pool and they're cheap value anyway.",
      "tag": "trick",
      "verified": false
    },
    {
      "id": "per-player",
      "title": "Upgrades are per player",
      "text": "An upgrade only boosts whoever uses it, and teammates get nothing. Decide as a team who gets what: give Strength to your carrier, Health to whoever scouts.",
      "tag": "team",
      "verified": true
    },
    {
      "id": "applies-next",
      "title": "Upgrades apply in the truck",
      "text": "Bought upgrades appear in your truck as you head into the next level, so don't panic when your stats don't change in the shop.",
      "tag": "basics",
      "verified": true
    },
    {
      "id": "compare-prices",
      "title": "Compare duplicate prices",
      "text": "Identical items can sit side by side at different prices. Check every copy before you pay.",
      "tag": "money",
      "verified": true
    },
    {
