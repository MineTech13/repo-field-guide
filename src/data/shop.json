  "tips": [
    {
      "id": "buy-together",
      "title": "Buy copies of the same upgrade together",
      "text": "Every upgrade of a type the team buys makes that type 50% more expensive (based on the original price). Copies already on the shelf keep the price they had when the shop was stocked. So if 3 Stamina upgrades are on the shelf, buying all 3 now is much cheaper than one per visit. Stamina can show up to 4 times, Range, Sprint and Crouch Rest 3 times, Health and Strength twice.",
      "tag": "money",
      "verified": true
    },
    {
      "id": "team-count",
      "title": "Upgrade prices are shared by the team",
      "text": "The +50% counts every purchase of that upgrade by anyone on the team. If your friend buys Strength, your next Strength costs more too. Plan who gets what.",
      "tag": "team",
      "verified": true
    },
    {
      "id": "pool",
      "title": "Unused upgrades block the shelf",
      "text": "How many copies of an upgrade the shop can show = its shop limit minus the copies you own but haven't used yet. Holding unused copies keeps that upgrade off the shelf and leaves room for other upgrades; using them frees the slots again.",
      "tag": "trick",
      "verified": true
    },
    {
      "id": "slots",
      "title": "What the shop can stock",
      "text": "Each visit the shelf has room for up to 10 upgrades, 8 items, 6 health packs and a few energy crystals. Copies are picked at random from what you're allowed to see.",
      "tag": "basics",
      "verified": true
    },
    {
      "id": "copy-prices",
      "title": "Each copy has its own price",
      "text": "Every copy rolls its own price between the item's minimum and maximum, so the same item can sit on the shelf at 6K and 8K. Always grab the cheaper copy first.",
      "tag": "money",
      "verified": true
    },
    {
      "id": "team-discount",
      "title": "Bigger teams pay less for upgrades",
      "text": "Upgrades and health packs get 10% cheaper for each extra player (up to 6 players). A full lobby pays about half price.",
      "tag": "team",
      "verified": true
    },
    {
      "id": "afford",
      "title": "The shop mostly shows what you can afford",
      "text": "Items that cost more than your current surplus are left out about 75% of the time. Saving up makes expensive items show up more often.",
      "tag": "trick",
      "verified": true
    },
    {
      "id": "price-climb",
      "title": "Health packs and crystals get pricier",
      "text": "Health packs cost 5% more for every level completed and energy crystals 20% more (capped after 15 levels). Stock up early in a run.",
      "tag": "money",
      "verified": true
    },
    {
      "id": "per-player",
      "title": "Upgrades are per player",
      "text": "An upgrade only boosts whoever uses it, and teammates get nothing. Decide as a team who gets what: give Strength to your carrier, Health to whoever scouts.",
      "tag": "team",
      "verified": true
    },
    {
      "id": "applies-next",
      "title": "Upgrades apply in the truck",
      "text": "Bought upgrades appear in your truck as you head into the next level, so don't panic when your stats don't change in the shop.",
      "tag": "basics",
      "verified": true
    },
    {
      "id": "mpc-once",
      "title": "Map Player Count: once per team",
      "text": "Once anyone buys Map Player Count, it stops appearing. One purchase covers the save, so don't double-buy.",
      "tag": "team",
      "verified": true
    },
    {
      "id": "tax-tokens",
      "title": "Reroll with Tax Tokens",
      "text": "The upgrade shelves have a reroll button that costs Tax Tokens, not surplus. Bring tax boxes found in a level to an extraction point. They don't count toward quota, but each becomes a token.",
      "tag": "trick",
      "verified": true
    },
    {
      "id": "stun-first",
      "title": "Buy a stun before big guns",
      "text": "A Tranq Gun or Prodzap answers almost every tier-3 monster (Pony can only be grabbed when stunned). Damage weapons come second.",
      "tag": "loadout",
      "verified": true
    },
    {
      "id": "cheap-explosives",
      "title": "Explosives are the cheapest damage",
      "text": "Grenades and mines cost about $2–3K. Stack mines on a Huntsman or Trudge route for a big orb payout.",
      "tag": "loadout",
      "verified": true
    },
    {
      "id": "disposal",
      "title": "Don't overspend on a weak run",
      "text": "Missing a quota sends you to Disposal and wipes the save. If the next level jumps in monsters (levels 6, 9, 11), keep money for health packs.",
      "tag": "money",
      "verified": true
    }
  ],
  "secretShop": {
    "intro": "Since the Cosmetics Update, the Service Station spawns in several random layouts, and each can hide its secret shop in a different spot. Some layouts have none.",
    "stock": [
      "human-gun",
      "human-adventure-cable",
      "duct-taped-grenades",
      "human-grenade",
      "duck-bucket"
    ],
    "layouts": [
      {
        "id": "toilet",
        "name": "Toilet / WC layout",
        "emoji": "🚽",
        "how": [
          "Go into the first toilet cubicle",
          "Stand in it and flush",
          "The flush launches you up into a crawlspace: that's the secret shop"
        ],
        "needs": "Nothing. The easiest one."
      },
      {
        "id": "basement",
        "name": "Freezer basement",
        "emoji": "🧊",
        "how": [
          "Go to the back of the station where the freezers with cracked glass are",
          "Find the fake floor tile in front of them",
          "Step on it and drop into the basement (with dormant semibots)"
        ],
        "needs": "Nothing."
      },
      {
        "id": "garage",
        "name": "Garage",
        "emoji": "🚗",
        "how": [
          "Find the plain white door opposite where the truck parks",
          "Walk through into a garage with a car and boarded-up doors",
          "The whole garage is the secret shop"
        ],
        "needs": "Nothing."
      },
      {
        "id": "diner",
        "name": "Diner",
        "emoji": "🍔",
        "how": [
          "Look behind the main service counter near the registers",
          "Find the cracked wall",
          "Break it with a grenade or a melee weapon"
        ],
        "needs": "A grenade or melee weapon."
      },
      {
        "id": "office",
        "name": "Manager's office",
        "emoji": "🗝️",
        "how": [
          "If the station has a door to a staircase, it's this layout",
          "Find the small white keycard: near plants, behind the register, or on boxes and shelves",
          "Take it upstairs and unlock the door with the keycard slot"
        ],
        "needs": "The keycard (search the shop)."
      },
      {
        "id": "ceiling",
        "name": "Ceiling hatch (older layout)",
        "emoji": "🔦",
        "how": [
          "Look above the shelves for a smoke detector near the ceiling",
          "On the medkit side of the display case, count about 2 ceiling tiles out",
          "Knock the panel open (throw an item or use knockback), then climb up with a Phase Bridge, stacked boxes, Extra Jump or a teammate"
        ],
        "needs": "A way to reach the ceiling."
      }
    ],
    "sources": [
      "gamerant-secret",
      "gamesgg-secret",
      "fantime-items"
    ]
  },
